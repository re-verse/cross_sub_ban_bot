[Unit]
Description=Run Cross-Sub Ban Bot every 20 minutes

[Timer]
# Every 5 min. The GitHub Actions constraint is gone (the server has no
# scheduling queue), and Reddit's rate limit is nowhere near binding: a
# quiet run is ~35 API calls against a ~1000-per-10-min budget.
# Persistent=true runs a missed cycle after downtime.
OnCalendar=*:0/5
Persistent=true
# Small random spread so we're not hammering Reddit exactly on the tick
RandomizedDelaySec=30

[Install]
WantedBy=timers.target
